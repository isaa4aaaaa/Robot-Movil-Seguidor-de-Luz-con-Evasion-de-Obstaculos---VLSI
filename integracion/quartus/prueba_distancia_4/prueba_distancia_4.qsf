# Cuatro HC-SR04 por turnos. Un divisor externo por ECHO; SW1/SW0 seleccionan canal.
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY prueba_distancia_4
set_global_assignment -name VHDL_INPUT_VERSION VHDL_1993
set_global_assignment -name VHDL_FILE ../../../componentes/sensores_distancia/vhdl/medir_hcsr04.vhd
set_global_assignment -name VHDL_FILE ../../../componentes/sensores_distancia/vhdl/cuatro_hcsr04.vhd
set_global_assignment -name VHDL_FILE ../../../componentes/visualizacion/vhdl/distancia_displays.vhd
set_global_assignment -name VHDL_FILE ../../../componentes/visualizacion/vhdl/seleccionar_distancia.vhd
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name SDC_FILE prueba_distancia_4.sdc
set_global_assignment -name BDF_FILE prueba_distancia_4.bdf
set_location_assignment PIN_P11 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_location_assignment PIN_C14 -to hex0[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[0]
set_location_assignment PIN_E15 -to hex0[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[1]
set_location_assignment PIN_C15 -to hex0[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[2]
set_location_assignment PIN_C16 -to hex0[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[3]
set_location_assignment PIN_E16 -to hex0[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[4]
set_location_assignment PIN_D17 -to hex0[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[5]
set_location_assignment PIN_C17 -to hex0[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[6]
set_location_assignment PIN_D15 -to hex0[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex0[7]
set_location_assignment PIN_C18 -to hex1[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[0]
set_location_assignment PIN_D18 -to hex1[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[1]
set_location_assignment PIN_E18 -to hex1[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[2]
set_location_assignment PIN_B16 -to hex1[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[3]
set_location_assignment PIN_A17 -to hex1[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[4]
set_location_assignment PIN_A18 -to hex1[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[5]
set_location_assignment PIN_B17 -to hex1[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[6]
set_location_assignment PIN_A16 -to hex1[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex1[7]
set_location_assignment PIN_B20 -to hex2[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[0]
set_location_assignment PIN_A20 -to hex2[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[1]
set_location_assignment PIN_B19 -to hex2[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[2]
set_location_assignment PIN_A21 -to hex2[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[3]
set_location_assignment PIN_B21 -to hex2[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[4]
set_location_assignment PIN_C22 -to hex2[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[5]
set_location_assignment PIN_B22 -to hex2[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[6]
set_location_assignment PIN_A19 -to hex2[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to hex2[7]

set_location_assignment PIN_V8 -to trig[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to trig[0]
set_location_assignment PIN_V7 -to trig[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to trig[1]
set_location_assignment PIN_W6 -to trig[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to trig[2]
set_location_assignment PIN_W5 -to trig[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to trig[3]
set_location_assignment PIN_W8 -to echo[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to echo[0]
set_location_assignment PIN_W7 -to echo[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to echo[1]
set_location_assignment PIN_V5 -to echo[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to echo[2]
set_location_assignment PIN_AA15 -to echo[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to echo[3]
set_location_assignment PIN_C10 -to selector[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to selector[0]
set_location_assignment PIN_C11 -to selector[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to selector[1]

set_global_assignment -name LAST_QUARTUS_VERSION "24.1std.0 Lite Edition"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top